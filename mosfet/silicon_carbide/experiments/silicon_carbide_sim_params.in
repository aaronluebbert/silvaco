 go victorydevice simflags="-P 8 -160"
# sic vd-mosfet - identical structure, mesh and doping to ../silicon/silicon.in
# only the material and the physics models differ
# mesh WIDTH=8333333 um with the 12 um half cell gives 1 cm2, currents read as a/cm2

# mesh
MESH WIDTH=8333333
X.MESH loc=0    spacing=0.1
X.MESH loc=7.5  spacing=0.1
X.MESH loc=8.0  spacing=0.1
X.MESH loc=10.5 spacing=0.1
X.MESH loc=11.0 spacing=0.1
X.MESH loc=12.0 spacing=0.1
Y.MESH loc=-0.6  spacing=0.1
Y.MESH loc=-0.05 spacing=0.1
Y.MESH loc=0     spacing=0.1
Y.MESH loc=0.3   spacing=0.1
Y.MESH loc=1.0   spacing=0.1
Y.MESH loc=3.0   spacing=0.1
Y.MESH loc=20    spacing=0.1
Y.MESH loc=104   spacing=0.1
Y.MESH loc=106   spacing=0.1

# regions
REGION number=1 material=SiC
REGION number=2 material=SiO2 y.max=0

# electrodes
electrode name=gate material=polysilicon x.min=0 x.max=10.3 y.min=-0.55 y.max=-0.05
electrode name=source material=aluminum x.min=10.7 x.max=12 y.min=-0.6 y.max=0
electrode name=drain bottom

# doping
# drift region, one uniform background under the whole cell
doping uniform n.type conc=1.2e14 x.min=0 x.max=12 y.min=0 y.max=104
# p-base with a gaussian roll-off so the junction corner is rounded instead of a sharp box corner
# the roll-off reaches the drift doping 3.67 sigma outside the box (sigma = 0.5 um, so 1.83 um)
# so the plateau box is pulled in by that much and the metallurgical junction stays at x=8 and y=3
doping gaussian p.type conc=1e17 x.min=9.83 x.max=12 y.min=0 y.max=1.17 xn.characteristic=0.5 yp.characteristic=0.5
# n+ source
doping uniform n.type conc=1e19 x.min=10 x.max=11 y.min=0 y.max=0.3
# p+ body contact
doping uniform p.type conc=1e19 x.min=11 x.max=12 y.min=0 y.max=0.5
# n+ substrate
doping uniform n.type conc=1e19 x.min=0 x.max=12 y.min=104 y.max=106
# c-axis is along y, the direction current flows in this cell
material material=SiC taun0=1e-6 taup0=1e-6 zeta=0 theta=0
contact name=gate n.poly
models print altcvt fldmob srh auger bgn
impact anisotropic
output con.band val.band

# transfer curve
solve init
solve vdrain=0.1
log outf=sic_mosfet_transfer.log
solve vgate=0 vstep=0.1 vfinal=20 name=gate
log off
save outf=sic_mosfet_transfer.str
victoryvisual sic_mosfet_transfer.log

# output family
solve init
solve vdrain=0
# vg = 2 v
solve vgate=2
log outf=sic_mosfet_output_vg02.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 4 v
solve vgate=4
log outf=sic_mosfet_output_vg04.log
solve vdrain=0.5 vstep=0.5 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 6 v
solve vgate=6
log outf=sic_mosfet_output_vg06.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 8 v
solve vgate=8
log outf=sic_mosfet_output_vg08.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 10 v
solve vgate=10
log outf=sic_mosfet_output_vg10.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 12 v
solve vgate=12
log outf=sic_mosfet_output_vg12.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 14 v
solve vgate=14
log outf=sic_mosfet_output_vg14.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 16 v
solve vgate=16
log outf=sic_mosfet_output_vg16.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 18 v
solve vgate=18
log outf=sic_mosfet_output_vg18.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 20 v
solve vgate=20
log outf=sic_mosfet_output_vg20.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
save outf=sic_mosfet_family.str
victoryvisual sic_mosfet_family.str

# reverse blocking
solve init
solve vgate=0 vdrain=0
log outf=sic_mosfet_reverse.log
# sic diode with this drift broke down near 18.7 kv so the ramp is coarse and then fine
# ion.stop ends the ramp at breakdown so the second ramp is allowed to overshoot
solve vdrain=0 vstep=1 vfinal=15998 name=drain ionizint ion.stop ion.crit=1.0
solve vdrain=16000 vstep=0.1 vfinal=22000 name=drain ionizint ion.stop ion.crit=1.0
log off
save outf=sic_mosfet_reverse.str
victoryvisual sic_mosfet_reverse.log

# near-threshold output family
# sic threshold is about 5 to 6 v by hand, recenter these on vt from the transfer curve
solve init
solve vdrain=0
# vg = 5 v
solve vgate=5.0
log outf=sic_mosfet_nt_vg5p00.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 5.25 v
solve vgate=5.25
log outf=sic_mosfet_nt_vg5p25.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 5.5 v
solve vgate=5.5
log outf=sic_mosfet_nt_vg5p50.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 5.75 v
solve vgate=5.75
log outf=sic_mosfet_nt_vg5p75.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 6 v
solve vgate=6.0
log outf=sic_mosfet_nt_vg6p00.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 6.25 v
solve vgate=6.25
log outf=sic_mosfet_nt_vg6p25.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 6.5 v
solve vgate=6.5
log outf=sic_mosfet_nt_vg6p50.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 6.75 v
solve vgate=6.75
log outf=sic_mosfet_nt_vg6p75.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
solve vdrain=59 vstep=-1 vfinal=0 name=drain
# vg = 7 v
solve vgate=7.0
log outf=sic_mosfet_nt_vg7p00.log
solve vdrain=0.5 vstep=0.1 vfinal=60 name=drain
log off
save outf=sic_mosfet_nt_family.str
victoryvisual sic_mosfet_nt_family.str
quit
