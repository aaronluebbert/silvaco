go victorydevice simflags="-P 8 -160"
# sic vd-mosfet half cell - x=0 is jfet centerline, x=5 is source/p+ centerline
MESH
X.MESH loc=0   spacing=0.2
X.MESH loc=1.0 spacing=0.1
X.MESH loc=1.5 spacing=0.1
X.MESH loc=3.5 spacing=0.1
X.MESH loc=4.0 spacing=0.1
X.MESH loc=5.0 spacing=0.2
Y.MESH loc=-0.6 spacing=0.1
Y.MESH loc=-0.05 spacing=0.025
Y.MESH loc=0 spacing=0.005
Y.MESH loc=0.3 spacing=0.05
Y.MESH loc=1.0 spacing=0.1
Y.MESH loc=2.0 spacing=0.1
Y.MESH loc=3.0 spacing=0.3
Y.MESH loc=11.5 spacing=1
Y.MESH loc=13.5 spacing=1
REGION number=1 material=SiC
REGION number=2 material=SiO2 y.max=0
electrode name=gate material=polysilicon x.min=0 x.max=3.8 y.min=-0.55 y.max=-0.05
electrode name=source material=aluminum x.min=4.2 x.max=5 y.min=-0.6 y.max=0
electrode name=drain bottom
# drift - jfet column and everything below the base
doping uniform n.type conc=1.5e16 x.min=0 x.max=1.5 y.min=0 y.max=2.0
doping uniform n.type conc=1.5e16 x.min=0 x.max=5 y.min=2.0 y.max=11.5
# p-base - now 2.0 um deep
doping uniform p.type conc=1e17 x.min=1.5 x.max=5 y.min=0 y.max=2.0
# n+ source
doping uniform n.type conc=1e19 x.min=3.5 x.max=4.5 y.min=0 y.max=0.3
# p+ body contact
doping uniform p.type conc=1e19 x.min=4.5 x.max=5 y.min=0 y.max=0.5
# n+ substrate
doping uniform n.type conc=1e19 x.min=0 x.max=5 y.min=11.5 y.max=13.5
material material=SiC taun0=1e-6 taup0=1e-6 zeta=0 theta=0
contact name=gate n.poly
models print altcvt fldmob srh auger bgn
output con.band val.band
solve init
solve vdrain=0
# ---------------- vg = 2 v
solve vgate=2 
log outf=sic_mosfet_output_vg02.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 4 v
solve vgate=4
log outf=sic_mosfet_output_vg04.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 6 v
solve vgate=6
log outf=sic_mosfet_output_vg06.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 8 v
solve vgate=8
log outf=sic_mosfet_output_vg08.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 10 v
solve vgate=10
log outf=sic_mosfet_output_vg10.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 12 v
solve vgate=12
log outf=sic_mosfet_output_vg12.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 14 v
solve vgate=14
log outf=sic_mosfet_output_vg14.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 16 v
solve vgate=16
log outf=sic_mosfet_output_vg16.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 18 v
solve vgate=18
log outf=sic_mosfet_output_vg18.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
solve vdrain=19 vstep=-1 vfinal=0 name=drain
# ---------------- vg = 20 v
solve vgate=20
log outf=sic_mosfet_output_vg20.log
solve vdrain=0.25 vstep=0.25 vfinal=20 name=drain
log off
save outf=sic_mosfet_family.str
victoryvisual sic_mosfet_family.str
quit