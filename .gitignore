*.str
*.log
*.out
*.opt

# deckbuild and editor backups
*~
*.bak
*.bck
core
core.*

# extract output dumps (comment out if you write hand-made data here)
*.dat

# keep anything deliberately saved to results/
!results/**

# os junk
.DS_Store
Thumbs.db
desktop.ini

