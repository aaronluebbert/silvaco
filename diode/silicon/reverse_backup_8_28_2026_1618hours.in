go victorydevice

MESH WIDTH=1e8

#meshes
X.MESH loc=0 spacing=0.1
X.MESH loc=2 spacing=0.05
X.MESH loc=10 spacing=1.0
X.MESH loc=120 spacing=1.0
X.MESH loc=128 spacing=0.1
X.MESH loc=130 spacing=0.1
Y.MESH loc=0 spacing=0.5
Y.MESH loc=1 spacing=0.5

#region
REGION number=1 material=silicon

#electrodes
electrode num=1 name=anode left
electrode num=2 name=cathode rightgo victorydevice
MESH
#meshes
X.MESH loc=0     spacing=0.1
X.MESH loc=2     spacing=0.05
X.MESH loc=10    spacing=1.0
X.MESH loc=120   spacing=1.0
X.MESH loc=128   spacing=0.1
X.MESH loc=130   spacing=0.1
Y.MESH loc=0     spacing=0.5
Y.MESH loc=1     spacing=0.5
#region
REGION number=1 material=silicon
#electrodes
electrode num=1 name=anode left
electrode num=2 name=cathode right
#doping
#p+ anode
doping uniform p.type conc=1e19 x.min=0   x.max=2   y.min=0 y.max=1
#n- drift
doping uniform n.type conc=1e14 x.min=2   x.max=128 y.min=0 y.max=1
#n+ cathode
doping uniform n.type conc=1e19 x.min=128 x.max=130 y.min=0 y.max=1
#models
material material=silicon taun0=1e-6 taup0=1e-6
models print conmob fldmob srh auger bgn
output con.band val.band
#forward sweep: cathode grounded, anode ramped positive
solve init
solve vcathode=0
log outf=silicon_diode_forward.log
solve vanode=0   vstep=0.05 vfinal=1.0 name=anode
solve vanode=1.0 vstep=0.02 vfinal=4.0 name=anode
log off
save outf=silicon_diode_forward.str
victoryvisual silicon_diode_forward.log
quit

#doping
#p+ anode
doping uniform p.type conc=1e19 x.min=0 x.max=2 y.min=0 y.max=1
#n- drift
doping uniform n.type conc=1e14 x.min=2 x.max=128 y.min=0 y.max=1
#n+ cathode
doping uniform n.type conc=1e19 x.min=128 x.max=130 y.min=0 y.max=1

#models
material material=silicon taun0=1e-6 taup0=1e-6
models print conmob fldmob srh auger bgn
impact selb

output con.band val.band

#reverse breakdown sweep
solve init
solve vanode=0
log outf=silicon_diode_reverse.log
solve vcathode=0 vstep=20 vfinal=1100 name=cathode
solve vcathode=1100 vstep=2 vfinal=1400 name=cathode
log off

save outf=silicon_diode_reverse.str
victoryvisual silicon_diode_reverse.log
quit
